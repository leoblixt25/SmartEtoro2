# ─────────────────────────────────────────────
# CopyVault — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── Database ─────────────────────────────────
# SQLite (default for development)
DATABASE_URL=sqlite:///./etoro_platform.db

# PostgreSQL (for production) — uncomment and configure:
# DATABASE_URL=postgresql://user:password@localhost:5432/copyvault

# ── AI (Anthropic Claude) ─────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Telegram Bot ─────────────────────────────
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID (for notifications)
# Find it by messaging @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# Default portfolio ID to use for Telegram commands
DEFAULT_PORTFOLIO_ID=1

# ── CORS / Frontend ──────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── App settings ─────────────────────────────
# Set to "production" for live deployments
APP_ENV=development

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── eToro API ────────────────────────────────
# Keys from eToro Settings > Trading > API Key Management
# ETORO_API_KEY: The User Key (JWT token, starts with "eyJ")
# ETORO_API_SECRET: The Public API Key (alphanumeric)
# Generate at: https://www.etoro.com -> Settings -> Trading -> Create New Key
# ETORO_API_KEY=
# ETORO_API_SECRET=
# ETORO_ACCOUNT_ID=
